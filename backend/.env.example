# ============================================================
#  Clinical Lab Results Analyzer - backend configuration
#  Copy this file to `.env` and fill in real values.
#      cp backend/.env.example backend/.env
#  `.env` is git-ignored; `.env.example` is committed.
# ============================================================

# --- LLM provider -------------------------------------------------
# Which provider the Explain step uses: "gemini" | "mock"
# "mock" returns deterministic canned text so the whole pipeline
# runs end-to-end with NO API key. Use it while developing.
LLM_PROVIDER=mock

# Free key from https://aistudio.google.com/app/apikey  (no card required)
GEMINI_API_KEY=

# Gemini model used for explanations.
# flash-lite is ~4.5x faster than the larger flash models with no measurable
# loss in clinical quality here - severity is already decided deterministically
# before the model is called, so its extra reasoning adds latency, not accuracy.
# See docs/06-decision-log.md (D10) for the measurements.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Server -------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Limits -------------------------------------------------------
# Reject absurdly large uploads before they reach the agent.
MAX_LABS_PER_REQUEST=200

# --- Assistant (retrieval-augmented help widget) -------------------
# Runs entirely on local models through Ollama - both the chat model and the
# one that indexes the documentation. There is no cloud fallback: the two
# embedding backends produce different vector spaces (768 dimensions from
# nomic-embed-text, 3072 from Gemini), so falling back would discard the index
# and rebuild it mid-question, and would send the reader's own lab values
# somewhere they did not choose. Without Ollama the widget says so and names
# the models to pull.
#
# An instruct model is used rather than a reasoning one: qwen3:4b took ~60s per
# answer on CPU and narrated its own thinking into the reply.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
ASSISTANT_ENABLED=true
