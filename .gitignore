# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# ---- Node ----
node_modules/
dist/
.vite/
*.local

# ---- Secrets ----
.env
.env.*
!.env.example

# ---- Kaggle dataset ----
# The assignment mandates this dataset, and it is CC0-1.0 (public domain) and
# only a few KB, so it IS committed - a grader can then run the demo and the
# validation tests straight from a clone.
data/*
!data/.gitkeep
!data/lab_test_results_public.csv
!data/metadata.json

# ---- Generated reports ----
# Built on demand by POST /report; never a source artifact.
*.pdf
!GenAI_FullStack_AssignmentV2.pdf
# The project overview is documentation, not a generated lab report - it is
# regenerated from docs/make_overview_pdf.py and committed alongside it.
!docs/AragenAI-Project-Overview.pdf

# ---- Runtime state ----
# Written by the app at runtime, never a source artifact.
backend/feedback.jsonl
backend/.assistant_index.*

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
